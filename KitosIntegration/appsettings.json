{
  "ConnectionStrings": {
    "kitos_HangfireDB": "Host=localhost;Port=5432;Database=kitos_hangfiredb;Username=postgres;Password=localNoSecret"
  },
  "AppSettings": {
    "LogFilePath": "C:\\Logs\\KitosIntegration-.txt",
    "BeskedfordelerCertificateThumbprint": "REPLACED_BY_ENVIRONMENT"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:\\Logs\\KitosIntegration-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
